# Clé de l'API Groq (https://console.groq.com)
GROQ_API_KEY=

# Modèle de génération (Groq)
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_MS=30000

# Modèle d'embedding local. Changer de modèle impose de réindexer (node rag/indexer.js).
EMBED_MODEL=Xenova/multilingual-e5-base
# Limite de tokens du modèle ; laisser vide pour la valeur connue (e5 : 512, MiniLM : 128)
EMBED_MAX_TOKENS=
# Laisser à 1 : sous Node, onnxruntime-web se bloque avec plusieurs threads
EMBED_THREADS=1

# Découpage, en tokens du modèle d'embedding
CHUNK_MAX_TOKENS=256
CHUNK_OVERLAP=40
SENTENCE_EXPLODE=0
INDEX_BATCH=32

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000

# API
PORT=3000
ALLOWED_ORIGINS=https://leopalich.com,https://www.leopalich.com
TRUST_PROXY=1
PROMPT_MAX_CHARS=500
RATE_LIMIT_PER_MINUTE=5
DAILY_LIMIT=300
